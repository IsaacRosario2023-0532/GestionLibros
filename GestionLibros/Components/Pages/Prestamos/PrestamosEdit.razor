@page "/Prestamos/Edit/{PrestamoId:int}"
@inject PrestamosService prestamosService
@inject LibrosService librosService
@inject EstudiantesService estudiantesService
@inject NavigationManager navigation
@rendermode InteractiveServer

<PageTitle> Edit Prestamos </PageTitle>

<div class="container mt-3">
    <div class="card shadow-lg">
        <div class="card-header">
            <h5 class="card-title text-center"> <strong> Editar Préstamo </strong></h5>
        </div>

        <EditForm Model="Prestamo" OnValidSubmit="GuardarPrestamo">
            <DataAnnotationsValidator />
            <div class="card-body">
                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label class="col-form-label"> <strong> Préstamo Id </strong> </label>
                        <InputNumber class="form-control" @bind-Value="Prestamo.PrestamoId" disabled />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label class="col-form-label"> <strong> Libro </strong> </label>
                        <InputSelect class="form-select" @bind-Value="Prestamo.LibroId">
                            <option value="0" disabled> Seleccione un libro </option>
                            @foreach (var libro in ListaLibros)
                            {
                                <option value="@libro.LibroId"> @libro.Titulo </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Prestamo.LibroId" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(MensajeError))
                {
                    <div class="text-danger"> @MensajeError </div>
                }

                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label class="col-form-label"> <strong> Estudiante </strong> </label>
                        <InputSelect class="form-select" @bind-Value="Prestamo.EstudianteId">
                            <option value="0" disabled> Seleccione un estudiante </option>
                            @foreach (var estudiante in ListaEstudiantes)
                            {
                                <option value="@estudiante.EstudianteId"> @estudiante.Nombre </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Prestamo.EstudianteId" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label class="col-form-label"> <strong> Fecha de Préstamo </strong> </label>
                        <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo" />
                        <ValidationMessage For="() => Prestamo.FechaPrestamo" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-6 mb-3">
                        <label class="col-form-label"> <strong> Fecha de Devolución </strong> </label>
                        <InputDate class="form-control" @bind-Value="FechaDevolucionValue" />
                        <div class="form-text"> Deja vacío si el libro aún no ha sido devuelto </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-center gap-2">
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar </button>
                <button type="button" class="btn btn-danger bi bi-trash" @onclick="() => MostrarModal = true"> Eliminar </button>
                <a class="btn btn-secondary bi bi-arrow-left" href="/Prestamos/Index"> Regresar </a>
            </div>
        </EditForm>
    </div>
</div>

@if (MostrarModal)
{
    <div class="modal d-block" role="dialog" tabindex="-1" style="background: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title mx-auto"> <strong> Eliminar préstamo </strong> </h5>
                </div>

                <div class="modal-body">
                    <label class="col-12"> <strong> Préstamo Id: </strong> @Prestamo.PrestamoId</label>
                    <label class="col-12"> <strong> Libro: </strong> @Prestamo.Libro?.Titulo</label>
                    <label class="col-12"> <strong> Estudiante: </strong> @Prestamo.Estudiante?.Nombre</label>
                    <label class="col-12"> <strong> Fecha de Préstamo: </strong> @Prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</label>
                    <label class="text-danger"> Esta seguro que desea eliminar este préstamo? </label>
                </div>

                <div class="modal-footer d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-danger bi bi-trash" @onclick="EliminarPrestamo"> Si, deseo eliminar </button>
                    <button type="button" class="btn btn-secondary bi bi-arrow-left" @onclick="() => MostrarModal = false"> Regresar </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int PrestamoId { get; set; }

    public Prestamos Prestamo { get; set; } = new();

    public List<Libros> ListaLibros = new();
    public List<Estudiantes> ListaEstudiantes = new();

    private bool MostrarModal { get; set; } = false;
    private string MensajeError { get; set; } = string.Empty;

    // Convierte entre DateTime? y DateTime para que InputDate lo acepte
    private DateTime FechaDevolucionValue
    {
        get => Prestamo.FechaDevolucion ?? default;
        set => Prestamo.FechaDevolucion = value == default ? null : value;
    }

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await librosService.Listar(l => true);
        ListaEstudiantes = await estudiantesService.Listar(e => true);
        Prestamo = await prestamosService.Buscar(PrestamoId) ?? new();
    }

    public async Task GuardarPrestamo()
    {
        if (Prestamo.FechaDevolucion.HasValue && Prestamo.FechaDevolucion.Value <= Prestamo.FechaPrestamo)
        {
            MensajeError = "La fecha de devolución debe ser mayor a la fecha de préstamo";
            return;
        }

        if (await prestamosService.LibroPrestado(Prestamo.LibroId, Prestamo.PrestamoId))
        {
            MensajeError = "Este libro ya está prestado y no ha sido devuelto";
            return;
        }

        if (await prestamosService.Guardar(Prestamo))
        {
            navigation.NavigateTo("/Prestamos/Index");
        }
    }

    public async Task EliminarPrestamo()
    {
        if (await prestamosService.Eliminar(PrestamoId))
        {
            navigation.NavigateTo("/Prestamos/Index");
        }
    }
}